<?xml version="1.0" encoding="utf-8"?>
<set android:interpolator="@anim/interpolator_common"
  xmlns:android="http://schemas.android.com/apk/res/android">
    <objectAnimator android:duration="100" android:valueFrom="1" android:valueTo="0.8" android:valueType="floatType" android:propertyName="scaleX" />
    <objectAnimator android:duration="100" android:valueFrom="1" android:valueTo="0.8" android:valueType="floatType" android:propertyName="scaleY" />
    <objectAnimator android:duration="150" android:startOffset="150" android:valueFrom="0.8" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleX" />
    <objectAnimator android:duration="150" android:startOffset="150" android:valueFrom="0.8" android:valueTo="1" android:valueType="floatType" android:propertyName="scaleY" />
    <objectAnimator android:duration="150" android:startOffset="150" android:valueFrom="#fdfdfd" android:valueTo="#fcd000" android:valueType="colorType" android:propertyName="fillColor" />
</set>
