<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_all_files_screen"
    android:gravity="center"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_all_files_card"
        android:paddingTop="36dp"
        android:paddingBottom="24dp"
        android:paddingLeft="28dp"
        android:paddingRight="28dp">

        <ImageView
            android:layout_width="84dp"
            android:layout_height="84dp"
            android:src="@mipmap/camera_app_logo"
            android:contentDescription="@null"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/all_files_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#1B1B1F"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/all_files_message"
            android:textSize="15sp"
            android:lineSpacingExtra="4dp"
            android:textColor="#49454F"
            android:gravity="center"/>

        <TextView
            android:id="@id/all_files_btn_allow"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="30dp"
            android:background="@drawable/bg_all_files_button_primary"
            android:text="@string/all_files_allow"
            android:textColor="#1B1B1F"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@id/all_files_btn_later"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="2dp"
            android:text="@string/all_files_later"
            android:textColor="#6B6800"
            android:textSize="15sp"
            android:textStyle="bold"
            android:gravity="center"/>
    </LinearLayout>
</FrameLayout>
