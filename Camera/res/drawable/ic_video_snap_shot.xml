<?xml version="1.0" encoding="utf-8"?>
<animated-selector
  xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:id="@id/state_pressed" android:drawable="@drawable/video_snap_shot_pressed" />
    <item android:id="@id/state_normal" android:drawable="@drawable/video_snap_shot_normal" />
    <transition android:drawable="@drawable/recording_snap_shot_anim_pressed" android:toId="@id/state_pressed" android:fromId="@id/state_normal" />
    <transition android:drawable="@drawable/recording_snap_shot_anim_normal" android:toId="@id/state_normal" android:fromId="@id/state_pressed" />
</animated-selector>
